# Environment configuration for Proctoring Backend
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=proctoring_db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Secrets (Replace with secure keys in production)
JWT_SECRET_KEY=temporary_dev_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Computer Vision & Proctoring ML Thresholds
FACE_ABSENCE_THRESHOLD_SEC=5.0
PROLONGED_HEAD_POSE_THRESHOLD_SEC=3.0
PROLONGED_GAZE_THRESHOLD_SEC=3.0
FACE_MISMATCH_INTERVAL_SEC=10.0
HEAD_POSE_YAW_THRESHOLD=25.0
HEAD_POSE_PITCH_THRESHOLD=20.0
HEAD_POSE_ROLL_THRESHOLD=20.0
FACE_MATCH_COSINE_THRESHOLD=0.40
EVENT_COOLDOWN_SEC=5.0
GAZE_RATIO_LEFT_THRESHOLD=0.35
GAZE_RATIO_RIGHT_THRESHOLD=0.65
GAZE_RATIO_UP_THRESHOLD=0.30
GAZE_RATIO_DOWN_THRESHOLD=0.70
FACE_LANDMARKER_MODEL_PATH=backend/app/ml/models/face_landmarker.task

# Object Detection (YOLOv8n) Proctoring Thresholds
YOLO_MODEL_PATH=backend/app/ml/models/yolov8n.pt
OBJECT_DETECTION_INTERVAL=3
CELL_PHONE_CONFIDENCE_THRESHOLD=0.50
PERSON_CONFIDENCE_THRESHOLD=0.50
UNAUTHORIZED_OBJECT_CONFIDENCE_THRESHOLD=0.45
CELL_PHONE_CONFIRMATION_FRAMES=2
CELL_PHONE_WINDOW_SIZE=3
OBJECT_DETECTION_COOLDOWN_SEC=5.0

# Audio Proctoring & Voice Activity Detection (VAD) Thresholds
AUDIO_SAMPLE_RATE=16000
AMBIENT_NOISE_CALIBRATION_SEC=20.0
SUSTAINED_SPEECH_THRESHOLD_SEC=3.0
SUDDEN_NOISE_RATIO_THRESHOLD=3.0
SUDDEN_NOISE_MIN_RMS=0.08
AUDIO_EVENT_COOLDOWN_SEC=5.0
LIP_MOTION_THRESHOLD=2.0
VAD_SPEECH_THRESHOLD=0.50

# Screen & Browser Activity Monitoring Thresholds
SCREEN_EVENT_COOLDOWN_SEC=2.0
TAB_SWITCH_MEDIUM_COUNT=3
TAB_SWITCH_HIGH_COUNT=6
AWAY_DURATION_MEDIUM_SEC=5.0
AWAY_DURATION_HIGH_SEC=15.0
EVIDENCE_STORAGE_DIR=backend/data/evidence



